<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Explorador de contenido aleatorio</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/explorador.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-dark barra-superior mb-4">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">
                    Explorador de contenido aleatorio
                </a>
                <span class="navbar-text small">Programación Web III</span>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top py-3 text-muted small">
        <div class="container">
            &copy; 2026 - Explorador de contenido aleatorio · APIs: DummyJSON, Dog CEO, CATAAS, Useless Facts
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
